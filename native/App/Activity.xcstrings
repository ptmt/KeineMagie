    "unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No completion data. Not a verified zero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Abschlussdaten. Keine bestätigte Null."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет данных о завершениях. Это не подтверждённый ноль."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin datos de finalización. No es un cero confirmado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée de fin. Ce n’est pas un zéro confirmé."
          }
        }
      }
    },
    "semantics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One saved successful translation, one fully listened podcast episode, or one checked Coach/Dictation exercise regardless of correctness. Rechecks count once; partial Dictation checks count. Listening is not tracked by current podcast readers. Deleted or undated history is unavailable. A dot marks incomplete coverage, never a verified zero. Not a mastery score."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gespeicherte erfolgreiche Übersetzung, eine vollständig gehörte Podcastfolge oder eine geprüfte Coach-/Diktatübung unabhängig vom Ergebnis. Erneute Prüfungen zählen einmal; Teildiktate zählen. Die aktuellen Podcastleser erfassen kein Hören. Gelöschter oder undatierter Verlauf fehlt. Ein Punkt markiert unvollständige Daten, keinen bestätigten Nullwert. Keine Kompetenzbewertung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один сохранённый успешный перевод, один полностью прослушанный эпизод или одно проверенное упражнение Тренера/Диктанта независимо от правильности. Повторные проверки считаются один раз; частичные диктанты учитываются. Текущие экраны подкастов не отслеживают прослушивание. Удалённая история и записи без даты недоступны. Точка обозначает неполные данные, а не подтверждённый ноль. Это не оценка знаний."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una traducción completada con éxito y guardada, un episodio escuchado por completo o un ejercicio comprobado de Coach/Dictado, sea correcto o no. Las revisiones cuentan una vez; los dictados parciales cuentan. Los lectores actuales no registran la escucha. Falta el historial eliminado o sin fecha. Un punto indica datos incompletos, nunca un cero confirmado. No mide el dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une traduction réussie enregistrée, un épisode écouté en entier ou un exercice Coach/Dictée vérifié, quelle que soit la correction. Les revérifications comptent une fois ; les dictées partielles comptent. Les lecteurs actuels ne suivent pas l’écoute. L’historique supprimé ou non daté manque. Un point indique des données incomplètes, jamais un zéro confirmé. Ce n’est pas un niveau de maîtrise."
          }
        }
      }
    },
