    "semantics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved Coach assessments and Dictation checks, including partial dictations. Not a mastery score. Translator and Podcasts have no exercise-completion event. Deleted or undated history is unavailable. A dot marks incomplete coverage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Coach-Bewertungen und Diktatprüfungen, auch unvollständige Diktate. Keine Kompetenzbewertung. Übersetzer und Podcasts haben kein Übungsabschlussereignis. Gelöschter oder undatierter Verlauf fehlt. Ein Punkt markiert unvollständige Daten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые оценки Coach и проверки диктантов, включая частичные. Это не оценка знаний. В Переводчике и Подкастах нет события завершения упражнения. Удалённая история и записи без даты недоступны. Точка обозначает неполные данные."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluaciones guardadas de Coach y dictados comprobados, incluidos los parciales. No mide el dominio. Traductor y Podcasts no registran ejercicios completados. El historial eliminado o sin fecha no está disponible. Un punto indica datos incompletos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évaluations Coach et vérifications de dictée enregistrées, y compris les dictées partielles. Ce n’est pas un niveau de maîtrise. Traducteur et Podcasts n’enregistrent pas de fin d’exercice. L’historique supprimé ou non daté est indisponible. Un point indique des données incomplètes."
          }
        }
      }
    }
  },
  "version": "1.0"
}
