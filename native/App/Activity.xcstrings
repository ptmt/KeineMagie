        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет данных о завершениях. Это не подтверждённый ноль."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin datos de finalización. No es un cero confirmado."
