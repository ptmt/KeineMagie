    "settings.keychain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht gewechselt: Schlüsselbund konnte nicht geleert werden. Bitte erneut abmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server not changed: unable to clear Keychain. Please try signing out again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не изменён: не удалось очистить Связку ключей. Попробуйте выйти снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor sin cambiar: no se pudo vaciar el llavero. Intenta cerrar sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur inchangé : impossible de vider le trousseau. Réessayez de vous déconnecter."
          }
        }
      }
    },
    "settings.revocation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server gewechselt und lokal abgemeldet. Widerruf beim bisherigen Server nicht bestätigt; die alte Sitzung könnte bis zum Ablauf gültig sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server changed and signed out locally. Revocation on the previous server was not confirmed; the old session may remain valid until expiry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер изменён, вход на устройстве завершён. Отзыв на прежнем сервере не подтверждён; старая сессия может действовать до истечения срока."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor cambiado y sesión local cerrada. La revocación en el servidor anterior no se confirmó; la sesión antigua podría seguir válida hasta caducar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur changé et déconnexion locale effectuée. La révocation sur l’ancien serveur n’est pas confirmée ; l’ancienne session peut rester valide jusqu’à son expiration."
          }
        }
      }
    },
    "keychain.failure": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund nicht verfügbar (%d). Gerät entsperren und erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain unavailable (%d). Unlock the device and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связка ключей недоступна (%d). Разблокируйте устройство и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llavero no disponible (%d). Desbloquea el dispositivo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trousseau indisponible (%d). Déverrouillez l’appareil et réessayez."
          }
        }
      }
    }
  },
