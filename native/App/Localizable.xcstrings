    "podcast.discovery.privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abonnement lädt nur Episodeninfos. Erst „Vorbereiten“ startet Transkription und Übersetzung. Neue Folgen über „Feed aktualisieren“ laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribing only discovers episode metadata. Prepare starts transcription and translation. Use Refresh feed to find new episodes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка загружает только сведения об эпизодах. Распознавание и перевод начинаются только после нажатия «Импортировать и подготовить на сервере». Чтобы найти новые эпизоды, нажмите «Обновить ленту»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción solo carga información de los episodios. La transcripción y la traducción empiezan al pulsar «Importar y preparar en el servidor». Usa «Actualizar fuente» para buscar episodios nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement charge uniquement les informations des épisodes. La transcription et la traduction commencent après avoir choisi « Importer et préparer sur le serveur ». Utilisez « Actualiser le flux » pour trouver de nouveaux épisodes."
          }
        }
      }
    },
