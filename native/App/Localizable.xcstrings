    "browser.warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur genehmigen, wenn du diesen Code selbst in deinem Browser angefordert hast. Dieser Browser erhält Zugriff auf dein Konto, deinen Verlauf und deine ChatGPT-Verbindung. Niemals fremde Codes bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve only if you requested this code in your own browser. That browser gains access to your account, history and ChatGPT connection. Never approve someone else’s code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждайте только код, запрошенный вами в собственном браузере. Браузер получит доступ к аккаунту, истории и подключению ChatGPT. Никогда не подтверждайте чужие коды."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba solo si solicitaste este código en tu propio navegador. Ese navegador tendrá acceso a tu cuenta, historial y conexión ChatGPT. Nunca apruebes códigos ajenos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez uniquement un code demandé dans votre propre navigateur. Ce navigateur aura accès à votre compte, historique et connexion ChatGPT. Ne confirmez jamais le code d’un tiers."
          }
        }
      }
    },
