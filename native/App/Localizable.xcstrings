    "Die Verbindung mit deinem persönlichen ChatGPT-Konto ist geplant und noch nicht implementiert. Es besteht keine Verbindung zu ChatGPT; es wird auch keine vorgetäuscht.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung mit deinem persönlichen ChatGPT-Konto ist geplant und noch nicht implementiert. Es besteht keine Verbindung zu ChatGPT; es wird auch keine vorgetäuscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal ChatGPT account connection is planned, not implemented. There is no ChatGPT connection, and none is simulated."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение личного аккаунта ChatGPT запланировано, но ещё не реализовано. Подключения к ChatGPT нет, и оно не имитируется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con tu cuenta personal de ChatGPT está prevista, pero no implementada. No hay conexión con ChatGPT ni se simula ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à votre compte ChatGPT personnel est prévue, mais pas encore implémentée. Aucune connexion à ChatGPT n’existe ni n’est simulée."
          }
        }
      }
    },
