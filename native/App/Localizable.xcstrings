  "outbox.foreground": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Submitted drafts retry while the app is open. Cancel stops future attempts, not an already sent request. Signing out deletes local drafts."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Gesendete Entwürfe werden bei geöffneter App erneut versucht. Abbrechen stoppt weitere Versuche, nicht bereits gesendete Anfragen. Abmelden löscht lokale Entwürfe."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Отправленные черновики повторяются, пока приложение открыто. Отмена останавливает будущие попытки, но не уже отправленный запрос. Выход удаляет локальные черновики."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Les brouillons soumis sont réessayés tant que l’app est ouverte. Annuler arrête les prochaines tentatives, pas une requête déjà envoyée. La déconnexion supprime les brouillons locaux."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Los borradores enviados se reintentan mientras la app está abierta. Cancelar detiene intentos futuros, no una solicitud ya enviada. Cerrar sesión elimina los borradores locales."
        }
      }
    }
  },
  "outbox.retry": {
    "extractionState": "manual",
