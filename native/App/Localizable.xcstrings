    "chatgpt.direct.reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der offene ChatGPT-Login verlangt einen lokalen HTTP-Rückruf. iOS bietet dafür keinen dokumentierten Authentifizierungs-Rückruf; beim Wechsel zu Safari kann die App pausiert werden. Ein zuverlässiger direkter Web-Login benötigt die Freigabe durch OpenAI und eine registrierte HTTPS-Rückrufadresse. Es wird keine Verbindung vorgetäuscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ChatGPT sign-in requires a local HTTP callback. iOS provides no documented authentication callback for this; switching to Safari may suspend the app. Reliable direct web sign-in requires OpenAI approval and a registered HTTPS callback. No connection is simulated."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытый вход ChatGPT требует локального HTTP-адреса возврата. В iOS нет документированного механизма такого возврата; при переходе в Safari приложение может приостановиться. Для надёжного прямого веб-входа нужны одобрение OpenAI и зарегистрированный HTTPS-адрес возврата. Подключение не имитируется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso abierto de ChatGPT requiere un retorno HTTP local. iOS no documenta un retorno de autenticación así; al abrir Safari la app puede suspenderse. Un acceso web directo fiable requiere aprobación de OpenAI y un retorno HTTPS registrado. No se simula ninguna conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion ouverte ChatGPT exige un retour HTTP local. iOS ne documente pas ce type de retour d’authentification ; ouvrir Safari peut suspendre l’app. Une connexion web directe fiable nécessite l’accord d’OpenAI et un retour HTTPS enregistré. Aucune connexion n’est simulée."
          }
        }
      }
    },
