    "podcast.privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erkennung läuft lokal auf deinem Server. Übersetzungen nutzen nur dein verbundenes persönliches ChatGPT-Konto und dessen Kontingent; jedes Segment zählt als Übersetzungsversuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognition runs locally on your server. Translation uses only your connected personal ChatGPT account and its quota; each segment counts as a translation attempt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание выполняется локально на вашем сервере. Перевод использует только подключённый личный аккаунт ChatGPT и его квоту; каждый сегмент считается попыткой перевода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento se ejecuta localmente en tu servidor. La traducción usa solo tu cuenta personal de ChatGPT conectada y su cuota; cada segmento cuenta como un intento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance s’exécute localement sur votre serveur. La traduction utilise uniquement votre compte ChatGPT personnel connecté et son quota ; chaque segment compte comme une tentative."
          }
        }
      }
    },
