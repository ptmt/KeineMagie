    "shortcut.friendly.instruction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetze in einem freundlichen, natürlichen Ton. Bewahre Bedeutung und Fakten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate in a friendly, natural tone. Preserve meaning and facts."
