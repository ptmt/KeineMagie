    "chatgpt.native.notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari öffnet sich innerhalb der App. Zugangsdaten bleiben auf deinem Server. Simulator geprüft; echter OpenAI-Consent und physisches iPhone noch ungeprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari opens inside the app. Credentials stay on your server. Simulator tested; real OpenAI consent and physical iPhone untested."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari открывается в приложении. Учётные данные остаются на сервере. Симулятор проверен; реальное согласие OpenAI и iPhone ещё не проверены."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari se abre dentro de la app. Las credenciales quedan en tu servidor. Simulador probado; consentimiento real de OpenAI e iPhone físico sin probar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari s’ouvre dans l’app. Les identifiants restent sur votre serveur. Simulateur testé ; consentement OpenAI réel et iPhone physique non testés."
          }
        }
      }
