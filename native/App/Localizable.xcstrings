    "Diese Funktionen bleiben bis zur persönlichen Provider-Anbindung gesperrt. Gemeinsame alte Server-Verläufe werden nicht geladen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktionen bleiben bis zur persönlichen Provider-Anbindung gesperrt. Gemeinsame alte Server-Verläufe werden nicht geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These features remain disabled until personal provider connection is available. Old shared server histories are not loaded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти функции отключены до подключения личного провайдера. Старые общие истории сервера не загружаются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas funciones seguirán desactivadas hasta conectar un proveedor personal. No se cargan historiales compartidos antiguos del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fonctions restent désactivées jusqu’à la connexion à un fournisseur personnel. Les anciens historiques partagés du serveur ne sont pas chargés."
          }
        }
      }
    },
