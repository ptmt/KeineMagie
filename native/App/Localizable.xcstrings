    "shortcut.scope": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät für dein Konto gespeichert. Auswahl gilt für eine Übersetzung und ergänzt die Übersetzungsanweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on this device for your account only. Selection applies to one translation and supplements its instruction."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется только на этом устройстве для твоей учётной записи. Выбор дополняет указание для одного перевода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda solo en este dispositivo para tu cuenta. La selección complementa la instrucción de una sola traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré uniquement sur cet appareil pour votre compte. La sélection complète la consigne d’une seule traduction."
          }
        }
      }
    },
