  "outbox.unassigned": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Not assigned to an account. Copy it before signing in; it is never sent automatically."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Keinem Konto zugeordnet. Vor der Anmeldung kopieren; wird nie automatisch gesendet."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Не привязан к аккаунту. Скопируйте перед входом; автоматически не отправляется."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Non attribué à un compte. Copiez-le avant de vous connecter ; il ne sera jamais envoyé automatiquement."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "No está asignado a una cuenta. Cópialo antes de iniciar sesión; nunca se envía automáticamente."
        }
      }
    }
  },
  "outbox.storage": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Could not save on this device. Nothing new was sent. Keep or copy your text."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Speichern auf diesem Gerät fehlgeschlagen. Nichts Neues gesendet. Text behalten oder kopieren."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Не удалось сохранить на устройстве. Новые запросы не отправлены. Сохраните или скопируйте текст."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Impossible d’enregistrer sur cet appareil. Aucun nouvel envoi. Conservez ou copiez votre texte."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "No se pudo guardar en este dispositivo. No se envió nada nuevo. Conserva o copia tu texto."
        }
      }
    }
  },
