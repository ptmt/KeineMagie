    "podcast.source.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine öffentlich abrufbare Audiospur oder kein Feed gefunden. Nutze eine Seite mit HTML-Audio oder einen öffentlichen RSS-/Atom-Feed. JavaScript-Player, geschützte Spotify-/Apple-Inhalte und Anmeldungen werden nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No public audio or feed found. Use an HTML-audio page or public RSS/Atom feed. JavaScript players, protected Spotify/Apple media and sign-in content are unsupported."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общедоступное аудио или лента не найдены. Используйте страницу с HTML-аудио или открытую ленту RSS/Atom. JavaScript-плееры, защищённые материалы Spotify/Apple и контент, требующий входа, не поддерживаются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró audio ni una fuente públicos. Usa una página con audio HTML o una fuente RSS/Atom pública. No se admiten reproductores JavaScript, contenido protegido de Spotify/Apple ni contenido que requiera iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun audio ou flux public trouvé. Utilisez une page avec audio HTML ou un flux RSS/Atom public. Les lecteurs JavaScript, les contenus protégés Spotify/Apple et les contenus nécessitant une connexion ne sont pas pris en charge."
          }
        }
      }
    },
