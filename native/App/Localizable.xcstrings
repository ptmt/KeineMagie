            "state": "translated",
            "value": "Server nicht gewechselt: Schlüsselbund konnte nicht geleert werden. Bitte erneut abmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server not changed: unable to clear Keychain. Please try signing out again."
