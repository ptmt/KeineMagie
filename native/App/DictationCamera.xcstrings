{
  "sourceLanguage": "de",
  "strings": {
    "dictation.camera.capacity": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort darf insgesamt höchstens 2400 Zeichen enthalten. Kürze den Text oder wähle ausdrücklich Ersetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The complete answer can contain up to 2400 characters. Shorten this text or explicitly choose Replace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ может содержать не более 2400 символов. Сократите текст или явно выберите замену."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta completa admite hasta 2400 caracteres. Acorta el texto o elige Reemplazar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse complète est limitée à 2400 caractères. Raccourcissez le texte ou choisissez Remplacer."
          }
        }
      }
    },

    "dictation.camera.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort fotografieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph answer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографировать ответ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiar respuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographier la réponse"
          }
        }
      }
    },
    "dictation.camera.privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Texterkennung läuft auf diesem Gerät. Das Foto wird nicht gespeichert oder hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text recognition runs on this device. The photo is not saved or uploaded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание текста выполняется на устройстве. Фото не сохраняется и не загружается на сервер."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se reconoce en este dispositivo. La foto no se guarda ni se sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte est reconnu sur cet appareil. La photo n’est ni enregistrée ni envoyée."
          }
        }
      }
    },
    "dictation.camera.instructions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere deine geschriebene Antwort. Prüfe und bearbeite den erkannten Text vor dem Einfügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph your written answer. Review and edit the recognized text before inserting it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте свой письменный ответ. Проверьте и исправьте распознанный текст перед вставкой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía tu respuesta escrita. Revisa y edita el texto reconocido antes de insertarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez votre réponse écrite. Vérifiez et modifiez le texte reconnu avant de l’insérer."
          }
        }
      }
    },
    "dictation.camera.permission": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff erlauben …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к камере…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à l’appareil photo…"
          }
        }
      }
    },
    "dictation.camera.capturing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto aufnehmen …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking photo…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Съёмка фото…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomando foto…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise de photo…"
          }
        }
      }
    },
    "dictation.camera.recognizing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text wird auf dem Gerät erkannt …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognizing text on this device…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание текста на устройстве…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconociendo texto en este dispositivo…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaissance du texte sur cet appareil…"
          }
        }
      }
    },
    "dictation.camera.review": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text prüfen und bearbeiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and edit text"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте и исправьте текст"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa y edita el texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier et modifier le texte"
          }
        }
      }
    },
    "dictation.camera.editor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannte Antwort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognized answer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознанный ответ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta reconocida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse reconnue"
          }
        }
      }
    },
    "dictation.camera.replace": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Antwort ersetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace existing answer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить текущий ответ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar la respuesta actual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer la réponse actuelle"
          }
        }
      }
    },
    "dictation.camera.appendHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig wird der Text an deine aktuelle Antwort angehängt. Ersetzt wird sie nur, wenn du die Option oben aktivierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, text is appended to your current answer. It is replaced only if you enable the option above."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию текст добавляется к текущему ответу. Замена произойдёт, только если включить опцию выше."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, el texto se añade a tu respuesta actual. Solo se reemplaza si activas la opción anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, le texte est ajouté à votre réponse actuelle. Elle n’est remplacée que si vous activez l’option ci-dessus."
          }
        }
      }
    },
    "dictation.camera.insert": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Insertar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérer"
          }
        }
      }
    },
    "dictation.camera.retake": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Foto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New photo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новое фото"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nueva foto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle photo"
          }
        }
      }
    },
    "dictation.camera.cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "dictation.camera.takePhoto": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать фото"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar foto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre une photo"
          }
        }
      }
    },
    "dictation.camera.simulatorFixture": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Generiertes Testbild erkennen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognize generated test image"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознать созданное тестовое изображение"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocer imagen de prueba generada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaître l’image de test générée"
          }
        }
      }
    },
    "dictation.camera.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine Kamera verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera is available on this device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве камера недоступна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay cámara disponible en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil photo n’est disponible sur cet appareil."
          }
        }
      }
    },
    "dictation.camera.denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist nicht erlaubt. Du kannst ihn in den iOS-Einstellungen für Keine Magie aktivieren oder deine Antwort selbst eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is denied. You can enable it in iOS Settings for Keine Magie or type your answer yourself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере запрещён. Разрешите его в настройках iOS для Keine Magie или введите ответ вручную."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está denegado. Puedes activarlo en los ajustes de iOS para Keine Magie o escribir tu respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’appareil photo est refusé. Vous pouvez l’autoriser dans les réglages iOS de Keine Magie ou saisir votre réponse."
          }
        }
      }
    },
    "dictation.camera.restricted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist auf diesem Gerät eingeschränkt. Du kannst deine Antwort selbst eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is restricted on this device. You can type your answer yourself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере ограничен на этом устройстве. Вы можете ввести ответ вручную."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está restringido en este dispositivo. Puedes escribir tu respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’appareil photo est restreint sur cet appareil. Vous pouvez saisir votre réponse."
          }
        }
      }
    },
    "dictation.camera.captureError": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto konnte nicht verarbeitet werden. Nimm ein neues Foto auf oder brich ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo could not be processed. Take a new photo or cancel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обработать фото. Сделайте новое фото или отмените."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido procesar la foto. Toma otra foto o cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo n’a pas pu être traitée. Prenez une autre photo ou annulez."
          }
        }
      }
    },
    "dictation.camera.noText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Text erkannt. Fotografiere deine Antwort bei gutem Licht und möglichst gerade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text was recognized. Photograph your answer in good light and keep the page straight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст не распознан. Сфотографируйте ответ при хорошем освещении, держа страницу ровно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha reconocido texto. Fotografía tu respuesta con buena luz y mantén la página recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun texte n’a été reconnu. Photographiez votre réponse avec un bon éclairage en gardant la page droite."
          }
        }
      }
    },
    "dictation.camera.recognitionError": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text konnte nicht erkannt werden. Nimm ein neues Foto auf oder brich ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text recognition failed. Take a new photo or cancel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось распознать текст. Сделайте новое фото или отмените."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido reconocer el texto. Toma otra foto o cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance du texte a échoué. Prenez une autre photo ou annulez."
          }
        }
      }
    }
  },
  "version": "1.0"
}
