# Optional legacy shared-provider mode only; never ship these in the native app.
# Native Apple verification requires neither value below.
OPENAI_API_KEY=
TTS_AUTH_TOKEN=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=mp3
OPENAI_BASE_URL=https://api.openai.com/v1
TTS_CACHE_DIR=cache
TTS_MAX_CHARS=4096
HISTORY_PATH=data/history.json
AUTH_PATH=data/auth.json
APPLE_CLIENT_ID=de.keinemagie.app
# Optional direct Apple web login; all four values are required to advertise it.
# Keep the actual .p8 OUTSIDE this repository/image, private 0600, server-only.
# See docs/WEB.md for primary App ID grouping and exact fixed callback:
# https://keinemagie.tinyserve.org/v1/auth/apple/callback
APPLE_WEB_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
# User registration: APPLE_WEB_CLIENT_ID=de.keinemagie.web, APPLE_TEAM_ID=49PJNAT2WC
WEB_ORIGIN=https://keinemagie.tinyserve.org
HOST=127.0.0.1
PORT=8787
