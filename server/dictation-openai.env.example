# Diktat OpenAI preparation — NOT enabled, published or deployed
# The user approved at most USD 10/month. Application guard additionally admits
# at most 10 uncached attempts/UTC month, reserving USD 1 permanently per attempt.
# Review docs/DICTATION-OPENAI-PREPARATION.md before enabling.
DICTATION_TTS_PROVIDER=
DICTATION_OPENAI_API_KEY_FILE=/run/secrets/dictation-openai.key
DICTATION_OPENAI_MODEL=gpt-realtime-2.1-mini
DICTATION_OPENAI_VOICE=marin
DICTATION_OPENAI_MAX_CHARS=1800
DICTATION_OPENAI_MAX_SECONDS=180
DICTATION_OPENAI_MAX_OUTPUT_TOKENS=4096
DICTATION_OPENAI_TIMEOUT_SECONDS=180
DICTATION_OPENAI_DAILY_CHARS=18000
DICTATION_OPENAI_DAILY_SECONDS=1800
DICTATION_OPENAI_DAILY_REQUESTS=10
DICTATION_OPENAI_CONCURRENCY=1
# Do not put a real API key into this file or any repository/CI variable.
